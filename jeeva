};

const MENTOR_LINES = {
  landing:"Tell me your goal and I'll find exactly what's standing between you and it.",
  profile:"No wrong answers here — just be honest, it makes your roadmap sharper.",
  quiz:"Take your time. I care more about accuracy than speed.",
  results:"Here's the honest picture. The gaps aren't bad news — they're just next steps.",
  roadmap:"This updates every time you retest. Come back and shake it up whenever you want."
};

/* ============================================================
   STATE
============================================================ */
let state = {
  name:"", education:"", currentSkills:[], goal:null,
  quiz:[], quizIndex:0, answers:[], skillScores:{},
  overallScore:0, attempt:0, prevOverallScore:null, badgesUnlocked:new Set()
};

/* ============================================================
   NAV / VIEW SWITCH
============================================================ */
function goTo(view){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+view).classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  const dock = document.getElementById('mentorDock');
  dock.style.display = (view==='landing') ? 'none' : 'flex';
  if(view!=='landing'){ setMentorLine(MENTOR_LINES[view]||''); }
}

function setMentorLine(text){
  const bubble = document.getElementById('dockBubble');
  if(bubble) bubble.textContent = text;
  speak(text);
}

/* ============================================================
   VOICE
============================================================ */
let voiceEnabled = true;
let cachedVoice = null;
function pickVoice(){
  const voices = window.speechSynthesis ? window.speechSynthesis.getVoices() : [];
  cachedVoice = voices.find(v=>/female|samantha|victoria|zira|google us english/i.test(v.name)) || voices[0] || null;
}
if(window.speechSynthesis){
  window.speechSynthesis.onvoiceschanged = pickVoice;
  pickVoice();
}
function speak(text){
  if(!voiceEnabled || !window.speechSynthesis || !text) return;
  try{
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    if(cachedVoice) u.voice = cachedVoice;
    u.pitch = 1.5; u.rate = 1.03; u.volume = 0.9;
    window.speechSynthesis.speak(u);
  }catch(e){}
}
document.addEventListener('click', function initAudioOnce(){
  if(window.speechSynthesis) pickVoice();
  document.removeEventListener('click', initAudioOnce);
}, {once:true});

document.getElementById('muteBtn').addEventListener('click', ()=>{
  voiceEnabled = !voiceEnabled;
  document.getElementById('muteBtn').innerHTML = voiceEnabled ? ICONS.volumeOn : ICONS.volumeOff;
  if(!voiceEnabled && window.speechSynthesis) window.speechSynthesis.cancel();
});

/* ============================================================
   PROFILE VIEW
============================================================ */
function renderSkillChips(){
  const wrap = document.getElementById('skillChips');
  wrap.innerHTML = ALL_SKILLS_POOL.map(s=>`<button class="chip" data-val="${s}">${s}</button>`).join('');
  wrap.querySelectorAll('.chip').forEach(chip=>{
    chip.addEventListener('click', ()=>{
      chip.classList.toggle('selected');
      const v = chip.dataset.val;
      if(chip.classList.contains('selected')) state.currentSkills.push(v);
      else state.currentSkills = state.currentSkills.filter(x=>x!==v);
    });
  });
}
document.getElementById('eduChips').querySelectorAll('.chip').forEach(chip=>{
  chip.addEventListener('click', ()=>{
    document.getElementById('eduChips').querySelectorAll('.chip').forEach(c=>c.classList.remove('selected'));
    chip.classList.add('selected');
    state.education = chip.dataset.val;
  });
});
renderSkillChips();

function renderGoalCards(){
  const wrap = document.getElementById('goalCards');
  wrap.innerHTML = Object.entries(CAREERS).map(([key,c])=>`
    <button class="goal-card" data-key="${key}">
      <div class="emoji">${c.emoji}</div>
      <h4>${c.label}</h4>
      <p>${c.blurb}</p>
    </button>`).join('');
  wrap.querySelectorAll('.goal-card').forEach(card=>{
    card.addEventListener('click', ()=>{
      wrap.querySelectorAll('.goal-card').forEach(c=>c.classList.remove('selected'));
      card.classList.add('selected');
      state.goal = card.dataset.key;
    });
  });
}
renderGoalCards();

/* ============================================================
   QUIZ
============================================================ */
function buildQuizSet(){
  const career = CAREERS[state.goal];
  const set = [];
  career.skills.forEach(skill=>{
    const pool = career.questions[skill];
    const pick = pool[Math.floor(Math.random()*pool.length)];
    set.push({skill, ...pick});
  });
  return set;
}

function startQuiz(){
  if(!state.goal){ alert("Pick a target career first — Mika needs it to choose your questions."); return; }
  state.name = document.getElementById('inpName').value.trim() || "there";
  state.quiz = buildQuizSet();
  state.quizIndex = 0;
  state.answers = [];
  goTo('quiz');
  renderQuestion();
}

function retakeQuiz(){
  state.quiz = buildQuizSet();
  state.quizIndex = 0;
  state.answers = [];
  state.prevOverallScore = state.overallScore;
  goTo('quiz');
  renderQuestion();
}

function renderQuestion(){
  const item = state.quiz[state.quizIndex];
  document.getElementById('quizSkillTag').textContent = item.skill;
  document.getElementById('quizCount').textContent = `Question ${state.quizIndex+1} of ${state.quiz.length}`;
  document.getElementById('quizProgress').style.width = `${(state.quizIndex/state.quiz.length)*100}%`;
  document.getElementById('quizQuestion').textContent = item.q;
  document.getElementById('nextQBtn').setAttribute('disabled','true');
  document.getElementById('nextQBtn').textContent = (state.quizIndex === state.quiz.length-1) ? 'See my results' : 'Next question';
  document.getElementById('nextQBtn').innerHTML += ' ' + ICONS.arrow;

  const optWrap = document.getElementById('quizOptions');
  optWrap.innerHTML = item.opts.map((o,i)=>`
    <button class="option" data-i="${i}"><span class="letter">${String.fromCharCode(65+i)}</span><span>${o}</span></button>
  `).join('');
  optWrap.querySelectorAll('.option').forEach(btn=>{
    btn.addEventListener('click', ()=>selectOption(btn, item));
  });
}

function selectOption(btn, item){
  const i = parseInt(btn.dataset.i);
  const optWrap = document.getElementById('quizOptions');
  optWrap.querySelectorAll('.option').forEach(o=>o.setAttribute('disabled','true'));
  optWrap.querySelectorAll('.option').forEach((o,idx)=>{
    if(idx===item.a) o.classList.add('correct');
    else if(idx===i) o.classList.add('wrong');
  });
  state.answers.push({skill:item.skill, correct: i===item.a});
  document.getElementById('nextQBtn').removeAttribute('disabled');
}

function nextQuestion(){
  if(state.quizIndex < state.quiz.length-1){
    state.quizIndex++;
    renderQuestion();
  } else {
    computeResults();
    goTo('results');
    renderResults();
  }
}

/* ============================================================
   RESULTS
============================================================ */
function computeResults(){
  const career = CAREERS[state.goal];
  const scores = {};
  career.skills.forEach(skill=>{
    const a = state.answers.find(x=>x.skill===skill);
    let base = a && a.correct ? 78 : 34;
    if(state.currentSkills.some(s=>skill.toLowerCase().includes(s.toLowerCase().split('/')[0]) )) base += 12;
    scores[skill] = Math.max(8, Math.min(100, base + Math.floor(Math.random()*10-5)));
  });
  state.skillScores = scores;
  const vals = Object.values(scores);
  state.overallScore = Math.round(vals.reduce((a,b)=>a+b,0)/vals.length);
  state.attempt += 1;
  state.badgesUnlocked.add('profile');
  state.badgesUnlocked.add('first_test');
  if(state.overallScore>=70) state.badgesUnlocked.add('rising_star');
  if(state.prevOverallScore!==null && state.overallScore>state.prevOverallScore) state.badgesUnlocked.add('comeback');
}

function renderResults(){
  const career = CAREERS[state.goal];
  document.getElementById('scoreGoalLabel').textContent = career.label;
  document.getElementById('resultsIntro').textContent = `Nice work, ${state.name}. Here's your honest breakdown.`;

  const circumference = 490;
  const offset = circumference - (state.overallScore/100)*circumference;
  const ring = document.getElementById('scoreRingFg');
  ring.style.strokeDashoffset = circumference;
  requestAnimationFrame(()=>{ ring.style.transition='stroke-dashoffset 1.2s cubic-bezier(.2,.8,.2,1)'; ring.style.strokeDashoffset = offset; });
  animateNumber(document.getElementById('scoreBigNum'), state.overallScore);

  const bars = document.getElementById('skillBars');
  bars.innerHTML = career.skills.map(skill=>{
    const v = state.skillScores[skill];
    const color = v>=70?'var(--green)':(v>=45?'var(--cyan)':'var(--pink)');
    return `<div class="skill-bar-row">
      <div class="skill-bar-top"><span>${skill}</span><span class="val">${v}%</span></div>
      <div class="skill-bar-track"><div class="skill-bar-fill" style="background:${color};" data-target="${v}"></div></div>
    </div>`;
  }).join('');
  setTimeout(()=>{
    bars.querySelectorAll('.skill-bar-fill').forEach(f=>{ f.style.width = f.dataset.target+'%'; });
  }, 80);

  const strengths = career.skills.filter(s=>state.skillScores[s]>=65);
  const gaps = career.skills.filter(s=>state.skillScores[s]<50);
  document.getElementById('tagCloud').innerHTML =
    strengths.slice(0,2).map(s=>`<span class="tag-pill tag-strength">${s}</span>`).join('') +
    gaps.slice(0,2).map(s=>`<span class="tag-pill tag-gap">${s}</span>`).join('');

  const topGap = [...career.skills].sort((a,b)=>state.skillScores[a]-state.skillScores[b])[0];
  const topStrength = [...career.skills].sort((a,b)=>state.skillScores[b]-state.skillScores[a])[0];
  const summary = `You're strongest in ${topStrength} (${state.skillScores[topStrength]}%) — that's a real asset for ${career.label}. Right now, ${topGap} (${state.skillScores[topGap]}%) is the biggest gap between you and that role, so that's exactly where your roadmap starts. Nothing here is fixed — retake the mock test anytime and this whole picture updates.`;
  document.getElementById('mikaSummary').textContent = summary;
  setMentorLine(`You're at ${state.overallScore}% overall. Your biggest opportunity right now is ${topGap}.`);
}

function animateNumber(el, target){
  let cur = 0;
  const step = Math.max(1, Math.round(target/30));
  const iv = setInterval(()=>{
    cur += step;
    if(cur>=target){ cur=target; clearInterval(iv); }
    el.textContent = cur+'%';
  }, 20);
}

/* ============================================================
   ROADMAP
============================================================ */
const BADGES = [
  {id:'profile', emoji:'🧭', name:'Goal Setter', desc:'Completed your profile'},
  {id:'first_test', emoji:'🎯', name:'First Assessment', desc:'Finished a mock test'},
  {id:'rising_star', emoji:'⭐', name:'Rising Star', desc:'Scored 70%+ overall'},
  {id:'comeback', emoji:'📈', name:'Comeback Kid', desc:'Improved on a retake'}
];

function buildRoadmap(){
  const career = CAREERS[state.goal];
  const ordered = [...career.skills].sort((a,b)=>state.skillScores[a]-state.skillScores[b]);

  const showBanner = state.attempt>1;
  const banner = document.getElementById('updateBanner');
  banner.style.display = showBanner ? 'flex' : 'none';
  if(showBanner){
    const delta = state.overallScore - (state.prevOverallScore??state.overallScore);
    document.getElementById('updateBannerText').textContent =
      delta>=0 ? `Your roadmap just updated — overall readiness moved up ${delta}%.`
                : `Your roadmap just updated to reflect your new results (${delta}%).`;
  }

  const tl = document.getElementById('timelineWrap');
  tl.innerHTML = ordered.map((skill,idx)=>{
    const v = state.skillScores[skill];
    const tier = v<50?'Foundation':(v<75?'Strengthen':'Sharpen');
    const mastered = v>=75;
    const tasks = career.roadmap[skill].tasks;
    return `
    <div class="tl-item ${mastered?'mastered':''}">
      <div class="tl-dot">${mastered?'✓':(idx+1)}</div>
      <div class="tl-card glass">
        <div class="tl-tier">${tier.toUpperCase()} STAGE</div>
        <h4>${skill} <span style="font-weight:500;color:var(--ink-faint);font-size:13px;">— ${v}% now</span></h4>
        <ul class="tl-tasks">
          ${tasks.map(t=>`<li><span class="chk"></span>${t}</li>`).join('')}
        </ul>
        <div class="tl-meta"><span>~2 weeks</span><span>${tier}</span></div>
      </div>
    </div>`;
  }).join('') + `
    <div class="tl-item">
      <div class="tl-dot">${ordered.length+1}</div>
      <div class="tl-card glass">
        <div class="tl-tier">CAPSTONE</div>
        <h4>Ship a ${career.label} portfolio project</h4>
        <ul class="tl-tasks"><li><span class="chk"></span>Combine your strongest 3 skills into one real, shareable project</li></ul>
        <div class="tl-meta"><span>~3 weeks</span><span>Capstone</span></div>
      </div>
    </div>`;

  const bg = document.getElementById('badgeGrid');
  bg.innerHTML = BADGES.map(b=>`
    <div class="badge glass ${state.badgesUnlocked.has(b.id)?'unlocked':''}">
      <div class="b-emoji">${b.emoji}</div><h5>${b.name}</h5><p>${b.desc}</p>
    </div>`).join('');

  document.getElementById('roadmapScoreLabel').textContent = state.overallScore+'%';
  const bar = document.getElementById('roadmapScoreBar');
  bar.style.width = '0%';
  setTimeout(()=>{ bar.style.width = state.overallScore+'%'; }, 80);
  document.getElementById('roadmapDelta').textContent = state.prevOverallScore!==null
    ? `Previous attempt: ${state.prevOverallScore}% → now ${state.overallScore}%. Keep retaking to sharpen this.`
    : `This is your baseline. Retake the mock test after you complete a stage to watch it move.`;
}

/* landing badge preview (locked) */
document.getElementById('landingBadgePreview').innerHTML = BADGES.map(b=>`
  <div class="badge glass"><div class="b-emoji">${b.emoji}</div><h5>${b.name}</h5><p>${b.desc}</p></div>
`).join('');

/* init */
injectAvatars();
goTo('landing');
</script>
</body>
</html>